# Public example only. This is not the real VM configuration.
# example.invalid addresses cannot send mail. Never publish sasl_passwd.
myhostname = lab.example.invalid
inet_interfaces = loopback-only
relayhost = [smtp.example.invalid]:587
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = texthash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_tls_security_level = secure
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt
sender_canonical_maps = static:person@example.invalid
